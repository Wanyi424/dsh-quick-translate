{
  "name": "dsh-translate",
  "version": "0.2.9",
  "description": "翻译：DSH 模型、中英文提示词翻译、流式输出与本地历史记录。",
  "type": "module",
  "license": "MIT",
  "author": "Wanyi424",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wanyi424/dsh-quick-translate.git"
  },
  "homepage": "https://github.com/Wanyi424/dsh-quick-translate#readme",
  "bugs": {
    "url": "https://github.com/Wanyi424/dsh-quick-translate/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0-rc.2"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "prompts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "pack:plugin": "npm run typecheck && npm test && npm run build && npm pack --pack-destination dist",
    "check:browser": "node --import tsx scripts/browser-check.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.57.0",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
